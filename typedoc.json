{
  "$schema": "https://typedoc.org/schema.json",
  "name": "SaaS Analytics Dashboard Reference",
  "entryPoints": [
    "types/dashboard.ts",
    "lib/api.ts",
    "lib/mock-data.ts",
    "lib/utils.ts",
    "providers/react-query-provider.tsx",
    "components/ui/button.tsx",
    "components/ui/badge.tsx",
    "components/ui/meter-bar.tsx",
    "components/ui/skeleton.tsx",
    "components/ui/style-primitives.ts",
    "components/dashboard/dashboard-client.tsx",
    "components/dashboard/customer-table.tsx",
    "components/dashboard/delivery-insights.tsx",
    "components/dashboard/revenue-chart.tsx",
    "components/dashboard/ops-summary.tsx",
    "components/dashboard/kpi-card.tsx",
    "components/dashboard/theme-toggle.tsx",
    "components/dashboard/dashboard-loading.tsx",
    "app/api/customers/route.ts",
    "app/api/delivery/route.ts",
    "app/api/metrics/route.ts",
    "app/api/revenue/route.ts"
  ],
  "out": "docs/reference",
  "readme": "README.md",
  "tsconfig": "tsconfig.json",
  "excludeExternals": true,
  "excludePrivate": true,
  "excludeProtected": true,
  "githubPages": false,
  "highlightLanguages": ["bash", "http", "json", "powershell", "ts", "tsx", "txt"],
  "hideGenerator": true,
  "includeVersion": true
}
