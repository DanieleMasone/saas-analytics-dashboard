{
  "$schema": "https://typedoc.org/schema.json",
  "name": "SaaS Analytics Dashboard Reference",
  "entryPoints": [
    "types/dashboard.ts",
    "lib/api/api.ts",
    "lib/mock-data/mock-data.ts",
    "lib/utils/utils.ts",
    "providers/react-query-provider.tsx",
    "components/ui/button/button.tsx",
    "components/ui/badge/badge.tsx",
    "components/ui/meter-bar/meter-bar.tsx",
    "components/ui/skeleton/skeleton.tsx",
    "components/ui/style-primitives.ts",
    "components/dashboard/dashboard-shell/dashboard-shell.tsx",
    "components/dashboard/dashboard-client/dashboard-client.tsx",
    "components/dashboard/revenue-page-client/revenue-page-client.tsx",
    "components/dashboard/customers-page-client/customers-page-client.tsx",
    "components/dashboard/delivery-page-client/delivery-page-client.tsx",
    "components/dashboard/health-page-client/health-page-client.tsx",
    "components/dashboard/settings-page-client/settings-page-client.tsx",
    "components/dashboard/customer-table/customer-table.tsx",
    "components/dashboard/delivery-insights/delivery-insights.tsx",
    "components/dashboard/revenue-chart/revenue-chart.tsx",
    "components/dashboard/ops-summary/ops-summary.tsx",
    "components/dashboard/kpi-card/kpi-card.tsx",
    "components/dashboard/dashboard-loading/dashboard-loading.tsx",
    "app/api/customers/route.ts",
    "app/api/delivery/route.ts",
    "app/api/metrics/route.ts",
    "app/api/revenue/route.ts"
  ],
  "out": "docs/reference",
  "readme": "README.md",
  "tsconfig": "tsconfig.json",
  "excludeExternals": true,
  "excludePrivate": true,
  "excludeProtected": true,
  "githubPages": false,
  "highlightLanguages": ["bash", "http", "json", "powershell", "ts", "tsx", "txt"],
  "hideGenerator": true,
  "includeVersion": true
}
