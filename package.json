{
  "name": "saas-analytics-dashboard",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.10.0",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:pages": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "quality": "next typegen && tsc --noEmit && eslint && vitest run --coverage && typedoc --emit none",
    "docs": "typedoc",
    "docs:check": "typedoc --emit none"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.106.0",
    "@tanstack/react-query-devtools": "^5.106.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.68.0",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.5",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4",
    "typedoc": "^0.28.20",
    "typescript": "^5",
    "vitest": "^4.1.12"
  }
}
